# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env — it is git-ignored.

# The Gmail address the notifier logs in as and sends from.
DOTOSWAP_SMTP_USER=jaindhairyabookings@gmail.com

# A Gmail APP PASSWORD (16 characters), NOT your normal Gmail password.
# Create one at: Google Account -> Security -> 2-Step Verification -> App passwords
DOTOSWAP_SMTP_PASSWORD=your-16-char-app-password
