# ── Django core ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma-separated. Include your ngrok host in prod, e.g. myapp.ngrok-free.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins (scheme + host). Include https://<ngrok-host>
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Frontend origin(s) allowed to call the API with credentials
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────────────
# SQLite (default, dev):   sqlite:///db.sqlite3
# Postgres (prod):         postgres://user:pass@db:5432/expense
DATABASE_URL=sqlite:///db.sqlite3

# ── Field encryption ────────────────────────────────────────────────────
# 32-byte urlsafe base64 Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ── Google OAuth (allauth) ──────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── FX ──────────────────────────────────────────────────────────────────
# Primary provider is Frankfurter (no key). This just toggles live fetching.
FX_LIVE_FETCH=True

# ── Behind a TLS-terminating proxy (ngrok)? ─────────────────────────────
DJANGO_SECURE_PROXY=False
